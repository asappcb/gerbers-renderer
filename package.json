{
  "name": "gerbers-renderer",
  "version": "1.2.0",
  "description": "A frontend-only Gerber viewer for rendering PCB Gerbers directly in the browser.",
  "private": false,
  "type": "module",
  "main": "./dist/gerbers-renderer.umd.js",
  "module": "./dist/gerbers-renderer.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/gerbers-renderer.es.js",
      "require": "./dist/gerbers-renderer.umd.js"
    }
  },
  "unpkg": "./dist/gerbers-renderer.umd.js",
  "jsdelivr": "./dist/gerbers-renderer.umd.js",
  "bin": {
    "gerbers-render": "./bin/gerbers-render.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "prepack": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asappcb/gerbers-renderer.git"
  },
  "keywords": [
    "pcb",
    "gerber",
    "excellon",
    "viewer",
    "renderer",
    "frontend",
    "browser",
    "svg",
    "electronics"
  ],
  "author": "asappcb",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/asappcb/gerbers-renderer/issues"
  },
  "homepage": "https://github.com/asappcb/gerbers-renderer#readme",
  "dependencies": {
    "jszip": "^3.10.1",
    "libarchive.js": "^2.0.2"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@types/three": "^0.181.0",
    "jsdom": "^27.4.0",
    "three": "^0.181.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  }
}
